+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import {deserialize,serialize,tick,HQ,HOSPITAL,FIRE_STATION,GBR_BASE,KK_BASE} from '../dist/sim.js';
+import {migrateCityV2Population} from '../dist/city-v2-migration.js';
+import {MAP_ID,point,nearestRoad} from '../dist/geography.js';
+const saves=JSON.parse(fs.readFileSync(new URL('./fixtures/city-v1-saves.json',import.meta.url)));
+for(const [service,old] of Object.entries(saves))test(`City V1 ${service} save preserves progress and continues in City V2`,()=>{
+ const s=deserialize(JSON.stringify(old));assert.equal(s.mapId,MAP_ID);
+ for(const key of ['agency','xp','rank','shift','budget','trust','resolved','missed','history','life'])assert.deepEqual(s[key],old[key],key);
+ const restored=deserialize(serialize(s));assert.deepEqual(restored,s);
+ for(let n=0;n<100;n++){tick(s,.1);tick(restored,.1);}assert.deepEqual(restored,s);
+});
+const bases={HQ,HOSPITAL,FIRE_STATION,GBR_BASE,KK_BASE};
+test('City V2 migration sends detainees to HQ and patients to hospital, including handover',()=>{
+ const units=[false,true].flatMap(hospital=>['transporting','handover'].map(status=>({x:2,y:3,status,transport:{hospital},route:[]})));
+ const s={units,incidents:[]};migrateCityV2Population(s,bases);
+ for(const u of units){const end=u.status==='handover'?u:u.route.at(-1);assert.deepEqual(point(end),point(nearestRoad(u.transport.hospital?HOSPITAL:HQ)));}
+});
+test('City V2 migration rebuilds service return routes to their actual new bases',()=>{
+ const services=['ambulance','rescue','gbr','kk','police'].map(kind=>({kind,status:kind==='ambulance'?'transporting':'returning',x:2,y:3,route:[{x:4,y:4}]}));
+ migrateCityV2Population({units:[],incidents:[],services},bases);
+ for(const [i,home] of [HOSPITAL,FIRE_STATION,GBR_BASE,KK_BASE,HQ].entries())assert.deepEqual(point(services[i].route.at(-1)),point(nearestRoad(home)));
+});
