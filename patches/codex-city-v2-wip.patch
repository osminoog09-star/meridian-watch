+  if(u.ride){snap(u.ride.from);snap(u.ride.to);u.route=roadRoute(u,u.ride.phase==='ride'?u.ride.to:u.ride.from);}
+  if(u.status==='transporting')u.route=roadRoute(u,byId('centre'));
