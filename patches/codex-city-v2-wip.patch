+  const busy=['incident','recovering'].includes(r.status),destination=busy?r.resumeStatus:['work','toWork'].includes(r.status)?'work':'home';
+  const at=PLACES.get(profile[destination]).access;Object.assign(r,point(at));r.route=[];r.visit=null;
+  if(!busy)r.status=destination;
