+import test from 'node:test';import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import {createGame,nextShift,serialize,deserialize} from '../dist/sim.js';
+import {HERO,makeHero,validHero,suggestHero,heroFitness,heroLook,heroSummary,heroName,chiefUnlocked} from '../dist/hero.js';
+// Release O «Мой персонаж» (Claude, 16.10.2026).
+const raw={first:' Денис ',last:'Тамм',gender:'m',age:33,skin:2,hair:'short',hairColor:0,build:'strong',beard:true,glasses:false};
+
+test('the creator form becomes a hero: name, age, look; bad input is explained',()=>{
+ const r=makeHero(raw);assert.ok(r.ok);assert.equal(r.hero.first,'Денис');assert.equal(heroName(r.hero),'Денис Тамм');assert.ok(validHero(r.hero));
+ for(const [bad,why] of [[{...raw,first:'Д'},/имя/],[{...raw,last:''},/фамилию/],[{...raw,age:17},/Возраст/],[{...raw,age:60},/Возраст/]])assert.match(makeHero(bad).message,why);
+ assert.equal(makeHero({...raw,first:'<script>Ян'}).hero.first,'scriptЯн','no markup in a name');
+ assert.equal(makeHero({...raw,gender:'f',beard:true}).hero.beard,false,'no beard for a woman');
+ assert.equal(makeHero({...raw,skin:9,hair:'mohawk',build:'giant'}).hero.skin,1,'unknown look falls back');
+ assert.deepEqual(suggestHero(5,1),suggestHero(5,1));assert.ok(makeHero(suggestHero(5,1)).ok);
+ assert.ok(heroFitness({...raw,age:22,build:'strong'})>heroFitness({...raw,age:44,build:'slim'}));
+ assert.deepEqual(heroLook(makeHero(raw).hero),{skin:HERO.skins[2],hair:HERO.hairColors[0]});assert.match(heroSummary(makeHero(raw).hero),/33 года · крепкое/);
+});
+
+test('a career starts with the hero; the hero goes through shifts and saves; a broken hero is refused',()=>{
+ const s=createGame('career',7182,{schedule:'ppa',hero:raw});assert.equal(s.hero.last,'Тамм');assert.equal(s.life.fitness,heroFitness(s.hero));assert.equal(s.rank,0,'from the bottom');
+ s.ended=true;const n=nextShift(s);assert.deepEqual(n.hero,s.hero);assert.deepEqual(deserialize(serialize(n)).hero,s.hero);
+ const bad=JSON.parse(serialize(n));bad.hero.age=99;assert.throws(()=>deserialize(JSON.stringify(bad)));
+ const old=createGame('career',7182,{schedule:'ppa'});assert.equal(old.hero,undefined,'old campaigns have no hero and still load');deserialize(serialize(old));
+});
+
+test('the chief campaign opens only after the top rank; the start screen says so',()=>{
+ const s=createGame('career',7182,{schedule:'ppa',hero:raw});assert.equal(chiefUnlocked(s),false);s.rank=HERO.chiefRank;assert.equal(chiefUnlocked(s),true);
+ assert.equal(chiefUnlocked(createGame('chief',7182,{schedule:'ppa'})),false);
+ const app=fs.readFileSync(new URL('../dist/app.js',import.meta.url),'utf8');
+ assert.match(app,/function heroCreator\(\)/);assert.match(app,/Откроется, когда ваш персонаж пройдёт карьеру с низов/);assert.match(app,/id="becomeChief"/);
+ for(const id of ['heroFirst','heroLast','heroAge','heroHair','heroHairColor','heroBuild','heroStart'])assert.match(app,new RegExp(`id="${id}"`),id);
+});
