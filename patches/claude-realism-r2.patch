+//   · Briefing (инструктаж) at the station: tasks and 1–2 lookouts (ориентировки) for the shift.
+//   · Vehicle acceptance: below half a tank the crew refuels before patrol (fleet practice).
+//   · One 1-hour meal break (PPA: 1 h + short pauses per 12 h shift), taken when the queue is
+//     calm between the 4th and 8th hour; an urgent call interrupts it; no break → extra fatigue.
+//   · Reports and car handover in the last 30 minutes at the station.
+// Pure rules and texts; sim.js drives units through these statuses. Scheduled campaigns only.
+import {WORLD_SECONDS_PER_TICK_SECOND} from './transport.js';
+const ticks=minutes=>minutes*60/WORLD_SECONDS_PER_TICK_SECOND;
+export const ROUTINE=Object.freeze({briefing:ticks(15),meal:ticks(60),mealFrom:ticks(4*60),mealTo:ticks(8*60),mealLate:ticks(9*60),reports:ticks(30),mealRecovery:16,skippedMeal:8,acceptFuelShare:.5,boloBonus:1.2,boloTrust:1});
