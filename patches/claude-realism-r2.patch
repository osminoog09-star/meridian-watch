+ {variant:'dangerous-driving',text:'тёмный седан, гонки по ночным улицам'},
+ {variant:'vehicle-alert',text:'угнанный белый фургон'},
+ {variant:'no-licence',text:'водитель, лишённый прав, ездит на синем хэтчбеке'},
+ {variant:'shoplift',text:'мужчина в красной куртке, серия краж в магазинах'},
+ {variant:'bike-theft',text:'подросток с болторезом в рюкзаке, кражи велосипедов'},
+ {variant:'car-break',text:'двое в тёмной одежде вскрывают машины во дворах'},
+ {variant:'missing-elder',text:'пожилой мужчина с деменцией, мог уйти из дома'}
+]);
+const mix=(a,b)=>{let h=Math.imul((a|0)+31,2654435761)^Math.imul((b|0)+17,40503);h^=h>>>13;return (h>>>0);};
+export function briefingFor(seed,shift){const a=mix(seed,shift)%BOLO.length;let b=mix(shift,seed)%BOLO.length;if(b===a)b=(b+3)%BOLO.length;
+ return [a,b].map((k,n)=>({id:n+1,variant:BOLO[k].variant,text:BOLO[k].text,matched:null}));}
