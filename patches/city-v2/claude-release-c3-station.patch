--- a/tests/station.test.mjs	1970-01-01 03:00:00.000000000 +0300
+++ b/tests/station.test.mjs	2026-10-22 21:42:42.629508737 +0300
@@ -0,0 +1,45 @@
+import test from 'node:test';import assert from 'node:assert/strict';
+import {createGame,spawnIncident,tick,serialize,deserialize,assign,districtTrust,districtOf} from '../dist/sim.js';
+import {custodyFor,HANDOVER_TIME} from '../dist/calls.js';
+import {NODES} from '../dist/geography.js';
+import {IVS,ivsPlace,ivsCount,ivsFull,validIvs} from '../dist/station.js';
+import {ROLES,COURSES,roleBlocker,roleBonus} from '../dist/life.js';
+import {HOMES} from '../dist/home.js';
+// Claude 22.10 (City 2.0 «Участок»): the station's detention block and the district officer.
+
+test('the detention block holds six detainees and validates what it keeps',()=>{
+ const s={time:12};for(let k=0;k<IVS.capacity;k++)assert.equal(ivsPlace(s,'Драка №'+k),true);
+ assert.equal(ivsFull(s),true);assert.equal(ivsPlace(s,'седьмой'),false);assert.equal(ivsCount(s),6);assert.equal(validIvs(s),true);
+ assert.equal(validIvs({ivs:{held:new Array(7).fill({label:'x',at:1})}}),false);assert.equal(validIvs({ivs:{held:[{label:5,at:1}]}}),false);assert.equal(validIvs({}),true);
+});
+
+function arrest(fill){
+ for(let seed=1;seed<60;seed++){const s=createGame();s.seed=seed;s.nextIncident=9000;if(fill)s.ivs={held:Array.from({length:fill},(_,k)=>({label:'Ранее №'+k,at:1}))};const a=NODES[(seed*7)%NODES.length];
+  const i=spawnIncident(s,null,{variant:'street-fight',point:{x:a.x,y:a.y}});for(let k=0;k<6000&&!['resolved','missed'].includes(i.state);k++)tick(s,.1);
+  if(i.state==='resolved'&&custodyFor(i.variant,i.decision))return {s,i};}
+ return null;
+}
+test('an arrest ends in a cell of the station; when the cells are full the detainee is transferred to the prefecture',()=>{
+ const r=arrest(0);assert.ok(r);const {s,i}=r,u=s.units.find(x=>x.transport?.from===i.id);assert.ok(u);
+ let handover=0;for(let k=0;k<20000&&u.transport;k++){tick(s,.1);if(u.status==='handover')handover=Math.max(handover,u.handover??0);}
+ assert.equal(ivsCount(s),1);assert.ok(s.logs.some(l=>/ИВС: задержанный по вызову/.test(l.text)));assert.ok(handover<=HANDOVER_TIME+1e-9);
+ assert.deepEqual(deserialize(serialize(s)).ivs,s.ivs);
+ const f=arrest(IVS.capacity);assert.ok(f);const v=f.s.units.find(x=>x.transport?.from===f.i.id);let long=0;
+ for(let k=0;k<30000&&v.transport;k++){tick(f.s,.1);if(v.status==='handover')long=Math.max(long,v.handover??0);}
+ assert.ok(long>HANDOVER_TIME*2);assert.equal(ivsCount(f.s),IVS.capacity);assert.ok(f.s.logs.some(l=>/ИВС участка заполнен/.test(l.text)));
+ const file=(f.s.cases??[]).find(c=>c.id===f.i.id);if(file)assert.equal(file.status,'Переведён в ИВС префектуры');
+});
+
+test('the district officer: a role behind its own course, faster on neighbourhood calls, his district trusts him twice as fast',()=>{
+ assert.equal(ROLES.district.course,'community');assert.ok(COURSES.community);
+ const life={agency:'police',courses:{},fitness:60};assert.match(roleBlocker(life,'district',1,1),/Работа участкового/);life.courses.community=1;assert.equal(roleBlocker(life,'district',1,1),null);assert.match(roleBlocker(life,'district',0,1),/звание/);
+ assert.equal(roleBonus({role:'district'},'noise-flat'),1.35);assert.equal(roleBonus({role:'district'},'crash'),1);
+ const gain=role=>{const s=createGame('career',7182,{schedule:'ppa',service:'police'});s.nextIncident=9000;s.units.forEach(u=>u.auto=false);
+  const i=spawnIncident(s,null,{variant:'noise-flat',point:{x:NODES[0].x,y:NODES[0].y}}),d=districtOf(i);
+  s.life.role=role;s.life.home=Object.keys(HOMES).find(h=>HOMES[h].district===d);assert.ok(s.life.home,'a home in '+d);s.districts[d]=40;
+  assign(s,1,i.id,true);s.units[0].auto=true;const before=districtTrust(s,d);
+  for(let k=0;k<4000&&!['resolved','missed'].includes(i.state);k++)tick(s,.1);
+  return {ok:i.state==='resolved'&&i.units.includes(1),d:districtTrust(s,d)-before};};
+ const own=gain('district'),plain=gain(undefined);
+ assert.ok(own.ok&&plain.ok,'both calls closed by the player');assert.ok(own.d>plain.d*1.5,`${own.d} vs ${plain.d}`);
+});
