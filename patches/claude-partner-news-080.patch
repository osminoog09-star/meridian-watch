+export const NEWS_PER_SHIFT=4;
+export const newsRoom=(s,item)=>!!item&&(item.tone!=='good'||(s.news??[]).filter(n=>n.shift===s.shift&&n.tone==='good').length<NEWS_PER_SHIFT);
