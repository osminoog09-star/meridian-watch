+// R16 «Напарник» (Claude, 11.10.2026). A rookie rides with a field training officer; once the probation
+// ends (rank «Патрульный»), the mentor leaves and the department pairs the player with a regular
+// partner who has a character of their own. The pair has a bond: good shifts together build it, failed
+// calls and founded complaints wear it down, an evening out together helps. A strong bond makes the
+// crew work a little faster; a broken one ends with a transfer request. Career roster campaigns only.
+// Names are fictional. No rng: the next partner is picked by a hash of the seed and the shift.
+export const MENTOR=Object.freeze({name:'Алексей Морозов',trait:'mentor'});
+export const TRAITS=Object.freeze({
+ mentor:{label:'Наставник',about:'Ведёт стажировку: подсказывает и разбирает решения.'},
+ calm:{label:'Спокойный переговорщик',about:'Разговоры, конфликты и семейные вызовы идут на 10% быстрее.',types:[0,4]},
+ driver:{label:'Водитель-ас',about:'Остановки, погони и дорожные вызовы на 10% быстрее.',types:[1,5]},
+ sharp:{label:'Глазастый',about:'Поиск людей и кражи на 10% быстрее.',types:[2,3]},
+ steady:{label:'По инструкции',about:'Всё оформляет без ошибок: жалоб на экипаж на 30% меньше.',complaints:.7}
+});
+export const PARTNERS=Object.freeze([
+ {name:'Кристина Сепп',trait:'calm'},{name:'Марко Кукк',trait:'driver'},{name:'Ольга Мяги',trait:'sharp'},
