e="display:block;margin-top:8px;max-width:100%"></label><div style="margin-top:20px">${state.history.slice(0,8).map(h=>`<div class="logrow">${h.success?'✓':'—'} ${escapeHtml(h.name)} <small>№${h.id}</small>${h.outcome?'<p>'+escapeHtml(h.outcome)+'</p>':''}</div>`).join('')}</div>`);if($('reportService'))$('reportService').onclick=servicePanel;if($('nextShiftBtn'))$('nextShiftBtn').onclick=()=>{if(offDuty(state)){offDutyPlanner();return;}startNextShift();};if($('resumeBtn'))$('resumeBtn').onclick=close;$('exportBtn').onclick=()=>{const a=document.createElement('a'),url=URL.createObjectURL(new Blob([serialize(state)],{type:'application/json'}));a.href=url;a.download='meridian-watch-save.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);};$('importFile').onchange=async e=>{const file=e.target.files[0];if(!file)return;if(file.size>1024*1024){toast('Файл слишком большой');return;}try{const imported=deserialize(await file.text());pendingImport=imported;modal('<h2>Загрузить кампанию?</h2><p>Текущее сохранение будет заменено данными из выбранного файла.</p><div class="modal-actions"><button id="cancelImport">Отмена</button><button id="applyImport" class="primary">Загрузить</button></div>');$('cancelImport').onclick=report;$('applyImport').onclick=()=>{state=pendingImport;pendingImport=null;reportShown=false;selectedCall=null;selectedUnit=1;save();close();refresh(true);toast('Кампания загружена');};}catch{toast('Не удалось прочитать сохранение');}};}
