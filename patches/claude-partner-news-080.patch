+export const holidayNews=(label,shift)=>({title:`${label}: полиция Меридиана усиливает патрули`,tone:'neutral',media:pick(MEDIA,shift,5)});
+export const awardNews=(label,shift)=>({title:`Отделение отмечено: ${label.toLowerCase()}`,tone:'good',media:pick(MEDIA,shift,6)});
