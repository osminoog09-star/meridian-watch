+test('the mentor stays for the probation month, then a regular partner takes over',()=>{
+ let s=createGame('career',7182,{schedule:'ppa'});s=roll(s,1);assert.equal(s.life.partner.name,MENTOR.name);
+ s.xp=5000;s=roll(s,5);assert.equal(s.life.partner.trait,'mentor','not before a month');
+ s=roll(s,6);const p=s.life.partner;assert.notEqual(p.trait,'mentor');assert.ok(PARTNERS.some(x=>x.name===p.name));assert.equal(p.bond,BOND.newPartner);
