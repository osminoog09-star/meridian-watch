+// R15 trust balance (Claude, 11.10.2026). With 25–35 calls in a 12-hour roster shift, +2 per call kept
+// public trust pinned at 100%. In roster campaigns a good call now adds less the higher trust already
+// is, failures cost in full, and between shifts opinion drifts back toward a neutral 70%. Flawless
+// service holds trust in the low 90s, a missed call or two per shift brings it down to the 80s.
+// Legacy campaigns keep the old +2/−4 rule.
+export const TRUST_BALANCE=Object.freeze({gain:.25,span:30,neutral:70,drift:.2,districtGain:.5,districtDrift:.1});
+function addTrust(s,d){if(!Number.isFinite(d)||!d)return;if(isScheduled(s)&&d>0)d*=TRUST_BALANCE.gain*Math.max(0,100-s.trust)/TRUST_BALANCE.span;s.trust=Math.max(0,Math.min(100,s.trust+d));}
+function trustDrift(n){n.trust=Math.round((n.trust+(TRUST_BALANCE.neutral-n.trust)*TRUST_BALANCE.drift)*10)/10;if(n.districts)for(const k of Object.keys(n.districts))n.districts[k]=Math.round((n.districts[k]+(TRUST_BALANCE.neutral-n.districts[k])*TRUST_BALANCE.districtDrift)*10)/10;}
+function addDistrictTrust(s,id,d){if(!s.districts||s.districts[id]===undefined||!Number.isFinite(d)||!d)return;const v=s.districts[id];if(isScheduled(s)&&d>0)d*=TRUST_BALANCE.districtGain*Math.max(0,100-v)/TRUST_BALANCE.span;s.districts[id]=Math.max(0,Math.min(100,v+d));}
