--- a/tests/trust-display.test.mjs	1970-01-01 03:00:00.000000000 +0300
+++ b/tests/trust-display.test.mjs	2026-10-16 04:30:51.025064221 +0300
@@ -0,0 +1,11 @@
+import test from 'node:test';import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import {createGame,tick} from '../dist/sim.js';
+// J6 (Claude, 16.10.2026): trust grows in fractions on a scheduled shift; the header showed «90.52977267860129 %».
+test('trust is fractional in the game and shown as a whole percent',()=>{
+ const s=createGame('career',7182,{schedule:'ppa'});for(let k=0;k<4000&&Number.isInteger(s.trust);k++)tick(s,.5);
+ assert.ok(!Number.isInteger(s.trust),'a scheduled shift produces fractional trust');
+ const app=fs.readFileSync(new URL('../dist/app.js',import.meta.url),'utf8');
+ assert.doesNotMatch(app,/\$\{state\.trust\}/,'no raw trust in the interface');
+ assert.match(app,/\$\('trust'\)\.innerHTML=`\$\{Math\.round\(state\.trust\)\}<span>%<\/span>`/);
+});
