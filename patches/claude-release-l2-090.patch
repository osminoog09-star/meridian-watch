--- a/tests/service-economy.test.mjs	1970-01-01 03:00:00.000000000 +0300
+++ b/tests/service-economy.test.mjs	2026-10-16 14:47:21.458279647 +0300
@@ -0,0 +1,10 @@
+import test from 'node:test';import assert from 'node:assert/strict';
+import {createGame,ROSTER_CALL_INCOME} from '../dist/sim.js';
+import {PROFILES} from '../dist/agency.js';
+// L2 (Claude, 16.10.2026): rescuers get three times fewer calls than the police and the ambulance about half —
+// a call pays the station proportionally more, so every chief can afford equipment over a few shifts.
+test('a resolved call pays by service: police 15, ambulance 24, rescuers 45',()=>{
+ assert.equal(ROSTER_CALL_INCOME,15);assert.equal(Math.round(ROSTER_CALL_INCOME*PROFILES.ems.callIncome),24);assert.equal(Math.round(ROSTER_CALL_INCOME*PROFILES.rescue.callIncome),45);
+ assert.equal(PROFILES.dispatch.callIncome,undefined,'112 unchanged');
+ for(const service of ['rescue','ems'])assert.equal(createGame('chief',7182,{schedule:'ppa',service}).agency,service);
+});
