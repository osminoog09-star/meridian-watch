+ assert.deepEqual([0,1,2,3,4].map(shiftKind),['day','day','night','night','day']);
+ assert.deepEqual([1,2,3,4,5].map(i=>restBefore(i)/60),[12,24,12,96,12]);
+ assert.equal(shiftStartMinute(0)%1440,8*60);assert.equal(shiftStartMinute(2)%1440,20*60);
