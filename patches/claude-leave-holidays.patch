+// Career leave and health days, holidays of the calendar, paperwork in case files.
+
+const roster=()=>createGame('career',7182,{schedule:'ppa'});
+const finish=s=>{for(let k=0;k<SHIFT_TICKS*10+10&&!s.ended;k++)tick(s,.1);return s;};
+
+test('leave of one roster cycle: only after night shifts, uses 8 days, full rest and holiday pay',()=>{
+ let s=roster();assert.equal(s.life.leaveDays,LEAVE.days);assert.equal(s.life.healthDays,LEAVE.health);
+ assert.match(canTakeVacation(s.life,freeBlocks(1)),/после ночных/);
+ for(let k=0;k<3;k++){finish(s);s=nextShift(s);}finish(s);s.life.stress=70;s.life.sleepDebt=60;const money=s.life.money;
