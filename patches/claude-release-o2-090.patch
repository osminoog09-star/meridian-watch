+import test from 'node:test';import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import {createGame,tick,nextShift,serialize,deserialize,spawnIncident} from '../dist/sim.js';
+import {citizen,citizenFor,motiveFor,citizenLine,recordMet,peopleAfterShift,validPeople,arrests,PEOPLE,CITIZEN_BASE,CITIZEN_COUNT} from '../dist/citizens.js';
+import {NODES} from '../dist/geography.js';
+// Release O2 «Жители-личности» (Claude, 17.10.2026).
+const career=(seed=7182)=>createGame('career',seed,{schedule:'ppa',service:'police'});
+
+test('a person of the city is fixed by id: name, age, work, household, district, character',()=>{
+ assert.deepEqual(citizen(4242),citizen(4242));assert.equal(citizen(CITIZEN_BASE-1),null);assert.equal(citizen(CITIZEN_BASE+CITIZEN_COUNT),null);
+ const names=new Set(),ru=[];for(let id=CITIZEN_BASE;id<CITIZEN_BASE+2000;id++){const c=citizen(id);names.add(c.name);ru.push(c.russian);assert.ok(c.age>=3&&c.age<90);assert.ok(c.job&&c.household&&c.district);if(c.age<16)assert.match(c.job,/школьник|детский сад/);if(c.russian&&c.gender==='f')assert.match(c.last,/а$/);}
+ assert.ok(names.size>900,'many different people: '+names.size);const share=ru.filter(Boolean).length/ru.length;assert.ok(share>.12&&share<.28,'about one in five Russian names: '+share);
+ assert.match(citizenLine(citizen(5000)),/\d+ (год|года|лет) · /);
+});
+
+test('the people of a call fit their roles and the call: a missing child is a child, a fight has a hot-tempered person from the district',()=>{
+ for(let id=1;id<40;id++){assert.ok(citizenFor({id,variant:'missing-child',type:2},1,'Пропавший человек').age<=12);assert.ok(citizenFor({id,variant:'missing-elder',type:2},1,'Пропавший человек').age>=70);assert.ok(citizenFor({id,variant:'drunk-driver',type:5},0,'Водитель').age>=18);}
+ const c=citizenFor({id:7,variant:'street-fight',type:4},0,'Участник','centre');assert.ok(c.traits.some(t=>['temper','drinks'].includes(t)));assert.equal(c.district,'centre');
+ assert.match(motiveFor('domestic',c),/ссора|обиды/);
+ const s=career();const i=spawnIncident(s,null,{variant:'street-fight',point:NODES[40]});assert.ok(i.scene.participants.every(a=>a.residentId||(citizen(a.citizen)&&a.name===citizen(a.citizen).name)));
+ const legacy=createGame('career',7182);const j=spawnIncident(legacy,null,{variant:'street-fight',point:NODES[40]});assert.ok(j.scene.participants.every(a=>a.citizen===undefined),'old campaigns unchanged');
+});
+
+test('people the player met are remembered; custody leads to court next shift; repeated arrests cost the job',()=>{
+ const s=career();for(let k=0;k<4000&&!s.ended;k++)tick(s,.5);assert.ok(Object.keys(s.people).length>5,'people met on a shift');assert.ok(validPeople(s.people));
+ const id=CITIZEN_BASE+77;let r;for(let n=1;n<=3;n++){r=recordMet(s,id,{shift:n,call:900+n,variant:'domestic',role:'Участник',outcome:'arrest'});r.status='custody';peopleAfterShift(s,n+1);}
+ assert.equal(arrests(r),3);assert.ok(['jailed','free'].includes(r.status));assert.equal(r.status,'jailed','third arrest — prison');
+ if(!['без работы','пенсионер'].includes(citizen(id).job))assert.equal(r.lostJob,true);
+ peopleAfterShift(s,99);assert.equal(r.status,'free','released after the term');
+ s.ended=true;const n=nextShift(s);assert.ok(n.people[id]);deserialize(serialize(n));
+ for(const bad of [p=>{p[id].status='hero';},p=>{p[id].met[0].outcome='x';},p=>{p['5']={met:[],status:'free',until:0,fines:0,lostJob:false};}]){const raw=JSON.parse(serialize(n));bad(raw.people);assert.throws(()=>deserialize(JSON.stringify(raw)));}
+ for(let k=0;k<PEOPLE.limit+40;k++)recordMet(n,CITIZEN_BASE+1000+k,{shift:1,call:1,variant:'shoplift',role:'Свидетель',outcome:'witness'});assert.ok(Object.keys(n.people).length<=PEOPLE.limit+1,'the memory is bounded');
+});
+
+test('a repeat call brings the same person back; the UI has the dossier and the people list',()=>{
+ const s=career();let i,node;for(node of NODES.slice(100)){i=spawnIncident(s,null,{variant:'domestic',point:node});if(i.scene.participants[0].citizen)break;}const who=i.scene.participants[0].citizen;assert.ok(who);
+ const j=spawnIncident(s,null,{variant:'domestic',point:node,followUp:{from:i.id,reason:'снова',who}});assert.equal(j.scene.participants[0].citizen,who);assert.equal(j.scene.participants[0].name,citizen(who).name);
+ const app=fs.readFileSync(new URL('../dist/app.js',import.meta.url),'utf8');assert.match(app,/function personPanel\(id,back=null\)/);assert.match(app,/function peoplePanel\(\)/);assert.match(app,/id="menuPeople"/);assert.match(app,/data-person="\$\{a\.citizen\}"/);
+});
