diff -ruN a/tests/city-revision.test.mjs b/tests/city-revision.test.mjs
--- a/tests/city-revision.test.mjs	1970-01-01 03:00:00.000000000 +0300
+++ b/tests/city-revision.test.mjs	2026-10-23 09:44:14.998413081 +0300
@@ -0,0 +1,17 @@
+import test from 'node:test';import assert from 'node:assert/strict';
+import {createGame,tick,serialize,deserialize} from '../dist/sim.js';
+import {MAP_ID,nearestRoad,point} from '../dist/geography.js';
+// Claude 23.10 (owner: after the update the game started anew and two cars froze): a save from an earlier revision of
+// the City 2.0 plan loads — people and cars are snapped to the current streets and routes rebuilt — never rejected.
+test('a save of an earlier plan revision is migrated, not rejected',()=>{
+ assert.match(MAP_ID,/^meridian-city-v2@[0-9a-f]{10}$/);
+ const g=createGame('career',4711,{schedule:'ppa',service:'police'});for(let k=0;k<300;k++)tick(g,.5);
+ const old=JSON.parse(serialize(g));old.mapId='meridian-city-v2';
+ // the old plan had its streets a few metres elsewhere: shift every car and every resident off the current graph
+ for(const u of old.units){u.x+=4/1670;u.y-=3/1670;for(const p of u.route??[]){p.x+=4/1670;p.y-=3/1670;}}
+ for(const r of old.population?.residents??[]){r.x+=5/1670;r.y+=2/1670;for(const p of r.route??[]){p.x+=5/1670;p.y+=2/1670;}}
+ const s=deserialize(JSON.stringify(old));assert.equal(s.mapId,MAP_ID);assert.equal(s.xp,g.xp);assert.equal(s.shift,g.shift);
+ for(const u of s.units)if(!u.route.length&&['patrol','idle'].includes(u.status))assert.deepEqual(point(u),point(nearestRoad(u)));
+ for(let k=0;k<400;k++)tick(s,.5);assert.doesNotThrow(()=>deserialize(serialize(s)));
+ assert.throws(()=>deserialize(JSON.stringify({...old,mapId:'meridian-city-v2@zz'})));
+});
