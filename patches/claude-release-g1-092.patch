--- a/tests/yearend.test.mjs	1970-01-01 03:00:00.000000000 +0300
+++ b/tests/yearend.test.mjs	2026-10-18 02:02:02.951182688 +0300
@@ -0,0 +1,14 @@
+import test from 'node:test';import assert from 'node:assert/strict';
+import {createGame,nextShift,chooseLifeEvent,serialize,deserialize} from '../dist/sim.js';
+import {STORY_EVENTS,storyText,YEARS_LIMIT} from '../dist/story.js';
+// Release G1 «Итоги года» (Claude, 18.10.2026).
+test('a year of service closes with the numbers and the fates of the mentor and the classmate; the review is a scene',()=>{
+ let s=createGame('career',7182,{schedule:'ppa'});let seen=null;
+ for(let k=0;k<400&&!seen;k++){s.resolved=8;s.missed=k%5===0?1:0;s.ended=true;s=nextShift(s);if(s.life.event?.id==='story-yearend')seen=s;else if(s.life.event&&STORY_EVENTS[s.life.event.id])chooseLifeEvent(s,STORY_EVENTS[s.life.event.id].options[0].id);}
+ assert.ok(seen,'the year closes within the first 400 shifts');const y=seen.life.years.at(-1);
+ assert.ok(y.resolved>0&&y.rate>0&&y.rate<=100);assert.ok(y.mentorFate.length>10&&y.rivalFate.length>10);
+ const text=storyText(STORY_EVENTS['story-yearend'].text,seen);assert.ok(!text.includes('{'),text);assert.match(text,/закрытых вызовов/);
+ assert.ok(chooseLifeEvent(seen,'celebrate').ok);assert.equal(seen.life.event,null);deserialize(serialize(seen));
+ assert.ok(seen.news?.some(n=>/Год службы/.test(n.title))??true);
+ const bad=JSON.parse(serialize(seen));bad.life.years=Array.from({length:YEARS_LIMIT+1},()=>y);assert.throws(()=>deserialize(JSON.stringify(bad)));
+});
