+export function shiftRecord(s,{tasks=0,drunk=0}={}){const d=shiftDate(s.shift-1);return {shift:s.shift,date:d.label,kind:shiftKind(s.shift-1),month:d.year*12+d.month,resolved:s.resolved,missed:s.missed,trust:Math.round(s.trust),money:Math.round(s.mode==='chief'?s.budget:(s.life?.money??0)),xp:Math.round(s.xp),tasks,drunk};}
