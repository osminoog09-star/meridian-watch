diff -ruN a/tests/supervisor.test.mjs b/tests/supervisor.test.mjs
--- a/tests/supervisor.test.mjs	1970-01-01 03:00:00.000000000 +0300
+++ b/tests/supervisor.test.mjs	2026-10-17 01:09:11.669429773 +0300
@@ -0,0 +1,43 @@
+import test from 'node:test';import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import {createGame,tick,nextShift,serialize,deserialize,spawnIncident,assign,GBR_BASE,RANKS,chooseLifeEvent} from '../dist/sim.js';
+import {SUPERVISOR,leadNeeded,supervisorName} from '../dist/supervisor.js';
+import {LIFE_EVENTS,LIFE_EVENT_IDS} from '../dist/career2.js';
+// Release R1 «Служба как в ППА» (Claude, 17.10.2026): real ranks, the field supervisor, the talk with him.
+const career=(seed=7182)=>createGame('career',seed,{schedule:'ppa',service:'police'});
+
+test('ranks are the real police ranks of Estonia, from the bottom',()=>{
+ assert.deepEqual([...RANKS],['Младший констебль','Констебль','Старший констебль','Главный констебль','Комиссар']);
+ assert.equal(career().rank,0);
+});
+
+test('the supervisor comes to an armed call of the player\'s crew, leads it and returns to the station',()=>{
+ const s=career();s.units.forEach(u=>{u.auto=false;u.status='patrol';delete u.routineLeft;});
+ const i=spawnIncident(s,null,{variant:'street-fight',point:GBR_BASE});i.armed='knife';i.gbr=null;
+ assert.ok(assign(s,1,i.id,true));assert.ok(leadNeeded(i,{armed:true}));
+ tick(s,.5);const a=s.services.find(x=>x.kind==='lead');assert.ok(a,'the supervisor is on his way');assert.equal(i.lead,'called');
+ assert.ok(s.logs.some(l=>l.text.includes(supervisorName(s.seed))));s.units[0].auto=true;
+ for(let k=0;k<4000&&!['resolved','missed'].includes(i.state);k++){tick(s,.5);if(k%500===0)deserialize(serialize(s));}
+ assert.equal(i.lead,'onscene');assert.ok(s.logs.some(l=>/принял руководство/.test(l.text)));
+ for(let k=0;k<800&&s.services.some(x=>x.kind==='lead');k++)tick(s,.5);assert.ok(!s.services.some(x=>x.kind==='lead'),'back to the station');
+});
+
+test('no supervisor for an ordinary call or for a senior officer',()=>{
+ assert.equal(leadNeeded({units:[1],lead:null},{severity:2}),false);
+ assert.equal(leadNeeded({units:[2],lead:null},{armed:true}),false,'not the player\'s crew');
+ const s=career();s.rank=3;s.units.forEach(u=>{u.auto=false;u.status='patrol';});const i=spawnIncident(s,null,{variant:'street-fight',point:GBR_BASE});i.armed='knife';assign(s,1,i.id,true);tick(s,.5);
+ assert.ok(!s.services.some(x=>x.kind==='lead'));
+});
+
+test('every few shifts the supervisor talks with the officer; overtime pays',()=>{
+ assert.ok(!LIFE_EVENT_IDS.includes('supervisor'),'not a random event');
+ let s=career();let seen=false;
+ for(let k=0;k<SUPERVISOR.talkEvery+1&&!seen;k++){s.ended=true;s=nextShift(s);if(s.life.event?.id==='supervisor')seen=true;}
+ assert.ok(seen);const money=s.life.money;assert.ok(chooseLifeEvent(s,'overtime').ok);assert.equal(s.life.money,money+180);
+ assert.ok(LIFE_EVENTS.supervisor.options.length===4);deserialize(serialize(s));
+});
+
+test('a trainee sees only the own patrol in the shift panel',()=>{
+ const app=fs.readFileSync(new URL('../dist/app.js',import.meta.url),'utf8');
+ assert.match(app,/const visibleUnits=\(\)=>/);assert.match(app,/ВАШ ПАТРУЛЬ/);
+});
