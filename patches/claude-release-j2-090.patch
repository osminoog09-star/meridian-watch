+import test from 'node:test';import assert from 'node:assert/strict';
+import {createGame} from '../dist/sim.js';
+import {mentorOf,ensurePartner} from '../dist/partner.js';
+// Fix J2 (Claude, 15.10.2026): before the partner record exists the card named the police mentor in every service.
+test('every service names its own mentor, also before the partner record exists',()=>{
+ for(const [service,name] of [[undefined,'Алексей Морозов'],['rescue','Тарас Кульбок'],['ems','Мерле Таль'],['dispatch','Сирье Кукк']]){
+  const s=createGame('career',7182,{schedule:'ppa',service});delete s.life.partner;assert.equal(mentorOf(s.life).name,name,String(service));assert.equal(ensurePartner(s.life).name,name);
+ }
+ assert.equal(mentorOf(undefined).name,'Алексей Морозов');
+});
