+// Release J «Диспетчер 112» (Claude, 12.10.2026). The player works at the emergency centre of Meridian:
+// calls ring in, the caller says what they see (often not what it is), the dispatcher asks questions,
+// gives instructions on the phone and sends one service with a priority. Police, rescue and ambulance
+// crews of the city work on their own; their result depends on how fast and how right they were sent.
+// Facts behind the rules (Häirekeskus / 112 practice, general dispatch protocols):
+//  · one number for police, rescue and ambulance; the operator decides who goes and how urgently;
+//  · structured questions first: is the person breathing normally? is anyone trapped? is there a weapon?
+//  · «agonal» gasping is not breathing — the dispatcher starts CPR instructions over the phone;
+//  · priorities A (life threatening, lights and siren) … D (can wait); under-triage costs lives,
+//    over-triage takes crews away from others;
+//  · a crew sent to the wrong kind of call reports back and the call is passed on — minutes lost.
+// Pure rules: sim.js keeps the desk state and calls these; nothing here touches other campaigns.
+import {WORLD_SECONDS_PER_TICK_SECOND} from './transport.js';
+export const DISPATCH_SERVICE='dispatch';
+export const isDispatch=s=>s?.agency===DISPATCH_SERVICE;
+const hash=(a,b)=>{let h=Math.imul((a|0)+557,2654435761)^Math.imul((b|0)+29,1597334677);h^=h>>>15;h=Math.imul(h,2246822519);return ((h^h>>>13)>>>0)/4294967296;};
+export const ticksOf=minutes=>minutes*60/WORLD_SECONDS_PER_TICK_SECOND;
+export const SERVICES=Object.freeze({police:'Полиция',rescue:'Спасатели',ems:'Скорая'});
+export const PRIORITIES=Object.freeze({A:'A · угроза жизни',B:'B · срочно',C:'C · без угрозы жизни',D:'D · может подождать'});
+const ORDER='ABCD';
+// How long the system waits before a crew is sent, by priority (world minutes).
+export const RELEASE=Object.freeze({A:0,B:.5,C:3,D:8});
