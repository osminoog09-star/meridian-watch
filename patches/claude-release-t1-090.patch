+import test from 'node:test';import assert from 'node:assert/strict';
+import {createGame,nextShift,chooseLifeEvent,serialize,deserialize} from '../dist/sim.js';
+import {STORY_EVENTS,STORY_IDS,rivalName,mentorName,storyText,rivalRank,standing,PEOPLE} from '../dist/story.js';
+import {PARTNERS} from '../dist/partner.js';
+// Release T1 «Люди отдела» (Claude, 17.10.2026).
+const roll=(s,n,answer=null)=>{for(let k=0;k<n;k++){s.ended=true;s=nextShift(s);if(answer&&s.life.event&&STORY_EVENTS[s.life.event.id])chooseLifeEvent(s,answer(s.life.event.id));}return s;};
+test('the scenes come on their shifts, the answer moves the relationship and is remembered',()=>{
+ let s=createGame('career',7182,{schedule:'ppa'});
+ s=roll(s,STORY_EVENTS['story-rival'].shift-1);assert.equal(s.shift,4);assert.equal(s.life.event?.id,'story-rival');
+ const r=chooseLifeEvent(s,'laugh');assert.ok(r.ok);assert.equal(s.life.people.rival,PEOPLE.start.rival+10);assert.deepEqual(s.life.people.log.map(e=>[e.id,e.choice]),[['story-rival','laugh']]);
+ assert.equal(s.life.event,null);deserialize(serialize(s));
+ s=roll(s,STORY_EVENTS['story-swap'].shift-s.shift);assert.equal(s.life.event?.id,'story-swap');
+ s=roll(s,1);assert.equal(s.life.people.log.at(-1).choice,'no','unanswered: the calm default');assert.equal(s.life.people.rival,PEOPLE.start.rival);
+});
+test('every scene of a long career fires once; the default answers are safe; saves stay valid',()=>{
+ let s=createGame('career',4242,{schedule:'ppa'});s=roll(s,80,id=>STORY_EVENTS[id].options[0].id);
+ assert.deepEqual(s.life.people.log.map(e=>e.id).sort(),[...STORY_IDS].sort());deserialize(serialize(s));
+ for(const id of STORY_IDS){const o=STORY_EVENTS[id].options,d=o[o.length>2?2:0];assert.ok(!d.fx.integrity,`${id}: the default is not a breach`);}
+ const bad=JSON.parse(serialize(s));bad.life.people.log.push({id:'story-moon',choice:'x',shift:1});assert.throws(()=>deserialize(JSON.stringify(bad)));
+ const bad2=JSON.parse(serialize(s));bad2.life.people.rival=140;assert.throws(()=>deserialize(JSON.stringify(bad2)));
+});
+test('names: the rival is never a partner, the text speaks of real people; the rival has a rank of their own',()=>{
+ for(let seed=1;seed<40;seed++)for(const agency of ['police','rescue','ems','dispatch']){const n=rivalName(seed,agency);assert.ok(n&&!PARTNERS.some(p=>p.name===n));}
+ const s=createGame('career',7182,{schedule:'ppa'});const t=storyText(STORY_EVENTS['story-car'].text,s);assert.ok(!t.includes('{'));assert.ok(t.includes(rivalName(7182,'police')));
+ assert.equal(mentorName(s.life),'Алексей Морозов');assert.ok(rivalRank(s)>=0&&rivalRank(s)<=4);assert.equal(standing(85),'близкие люди');
+});
