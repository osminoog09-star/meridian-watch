+  {id:'score',label:'Сравнить звания и вызовы',fx:{rival:-5,xp:20}}]}
+});
+export const STORY_IDS=Object.freeze(Object.keys(STORY_EVENTS));
+const BEAT_AT=new Map(STORY_IDS.map(id=>[STORY_EVENTS[id].shift,id]));
+// The scene due on this shift (the career's shift counter), or null.
+export function storyBeat(s){const l=s.life;if(s.mode!=='career'||!l)return null;const id=BEAT_AT.get(s.shift);if(!id||(l.people?.log??[]).some(e=>e.id===id))return null;return id;}
+export function ensurePeople(life){if(!life)return null;if(!life.people||typeof life.people!=='object')life.people={rival:PEOPLE.start.rival,mentor:PEOPLE.start.mentor,log:[]};return life.people;}
+const clamp=v=>Math.max(0,Math.min(100,Math.round(v)));
+// The answer: relationships move, the scene goes into the story log.
+export function storyAnswer(life,id,choice,shift,fx){const p=ensurePeople(life);if(fx.rival)p.rival=clamp(p.rival+fx.rival);if(fx.mentor)p.mentor=clamp(p.mentor+fx.mentor);
+ p.log=[...p.log.filter(e=>e.id!==id),{id,choice,shift}].slice(-PEOPLE.limit);}
+export function storyText(str,s){return String(str).replaceAll('{rival}',rivalName(s.seed,s.life?.agency??s.agency)).replaceAll('{mentor}',mentorName(s.life));}
+// How the hero stands with a person, in words.
+export const standing=v=>v>=80?'близкие люди':v>=60?'хорошие отношения':v>=40?'ровно':v>=20?'холодно':'в ссоре';
+// The rival's own career: by the hero's rank and the relationship — a rival who is helped tends to keep pace.
+export function rivalRank(s){const r=s.rank??0,p=s.life?.people?.rival??50,h=(Math.imul((s.seed|0)+5,2246822519)>>>0)%3;return Math.max(0,Math.min(4,r+(h===0?1:h===1?0:-1)+(p>=70?0:p<30?-1:0)));}
+export function validPeople(l){const p=l?.people;if(p===undefined)return true;const int=(x,a,b)=>Number.isInteger(x)&&x>=a&&x<=b;
