+ 'story-pair':{shift:48,title:'Одна пара',text:'Из-за болезней вас с {rival} ставят в одну пару на ночную смену.',options:[
+  {id:'lead',label:'Взять старшинство на себя',fx:{rival:-5,xp:30,stress:3}},
+  {id:'equal',label:'Работать на равных',fx:{rival:12,xp:20,stress:-2}}]},
+ 'story-letter':{shift:60,title:'Письмо от наставника',text:'Открытка от {mentor}: «Слышал, как ты работаешь. Не торопись со званиями — торопись с людьми». И номер телефона: «Звони, если что».',options:[
+  {id:'call',label:'Позвонить и поблагодарить',fx:{mentor:10,stress:-8}},
+  {id:'keep',label:'Убрать открытку в шкафчик',fx:{stress:-3}}]},
+ 'story-year':{shift:72,title:'Год службы',text:'Год назад вы пришли в участок. {rival} подходит с кофе: «Ну что, кто кого?» — и впервые без подколки.',options:[
