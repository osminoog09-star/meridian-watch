+// The command centre sends the team to every armed call and to violence calls where the patrol asked for backup.
+export const gbrNeeded=i=>!!i&&(!!ARMED[i.armed]||(GBR_VARIANTS.has(i.variant)&&!!i.backupRequested));
+export const gbrOnScene=i=>i?.gbr==='onscene';
+export const kkOnScene=i=>i?.kk==='onscene';
+// How far a patrol may get on its own: at an armed call it keeps distance, at a barricade it holds the cordon.
+export function prefectureCap(i){if(!ARMED[i?.armed])return 1;if(!gbrOnScene(i))return PREFECTURE.holdCap;if(i.armed==='barricade'&&!kkOnScene(i))return PREFECTURE.barricadeCap;return 1;}
