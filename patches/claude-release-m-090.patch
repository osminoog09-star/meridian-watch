+// Release M «Полиция как в ППА» (Claude, 16.10.2026). In the Estonian police the rapid response unit
+// (kiirreageerijad) is not part of a patrol crew: it is a separate unit of the prefecture, on duty 24/7,
+// and the prefecture command centre sends it to the most dangerous calls (a weapon, violence, detaining a
+// dangerous person) and to support the criminal police. Patrols do not command it; they ask for it through
+// the command centre and keep a safe distance until it arrives. A barricaded armed person or hostages are a
+// task for K-Komando, the national special unit under the Central Criminal Police; the patrol and the rapid
+// response unit hold the cordon until it arrives.
+// Sources: ERR 632327 (kiirreageerijate arv kahekordistub), Järva Teataja 4368203, K-Commando (Wikipedia).
+// No random draws: which violence calls are armed is a hash of the campaign seed and the call id.
+export const PREFECTURE=Object.freeze({
+ gbrKmh:80,            // the rapid response car
+ gbrMax:1,             // one rapid response team on duty for the city
+ kkArrive:30,          // minutes: K-Komando comes from the capital
+ kkKmh:110,
+ armedEvery:4,         // every fourth violence call (by hash) is armed
+ barricadeEvery:4,     // ... and every fourth armed family conflict is a barricade
+ holdCap:.4,           // a patrol alone at an armed call keeps distance and cannot detain
+ barricadeCap:.6,      // the cordon holds, the detention is K-Komando's
+ gbrPace:1.3,          // the rapid response team detains faster
+ xp:6,                 // a patrol that waited for the team gets a little extra experience
+ gbrXp:2               // a call of the rapid response team is worth twice a patrol call (fewer, harder calls)
+});
+export const GBR_VARIANTS=Object.freeze(new Set(['street-fight','fan-fight','domestic','restraining-order']));
+// The team also takes arrests for the criminal police, pursuits of a car on a lookout and a burglary in progress.
+export const GBR_SUPPORT=Object.freeze(new Set(['suspect-found','vehicle-alert','dangerous-driving','alarm-burglary']));
+const BARRICADE_FROM=new Set(['domestic','restraining-order']);
+export const ARMED=Object.freeze({
+ knife:Object.freeze({prefix:'Нож',brief:'Звонящий видит у одного из участников нож. Командный центр направил ГБР префектуры: патрулю держать дистанцию до её прибытия.'}),
+ barricade:Object.freeze({prefix:'Вооружённый закрылся',brief:'Мужчина угрожает оружием и закрылся в квартире, внутри может быть человек. Патрулю и ГБР — оцепление; задержание проводит K-Komando.'})
+});
+export const ARMED_IDS=Object.freeze(Object.keys(ARMED));
+const mix=(a,b)=>{let h=Math.imul((a|0)+131,2246822519)^Math.imul((b|0)+29,3266489917);h^=h>>>13;return h>>>0;};
