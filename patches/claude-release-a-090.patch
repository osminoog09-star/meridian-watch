+  for(let k=pre;k<length;k++){const t=k/rate;o[k]=r()*Math.exp(-6.9*t/sp.decay)*.5;}
+  for(let e=1;e<=4;e++){const at=pre+Math.round(rate*sp.pre*e*(1.3+ch*.17));if(at<length)o[at]+=.6/e;}}
+ return out;}
+// Is this point inside a building footprint? (people around a call stand outside, on the street or in the yard)
+export function inBuilding(x,y){if(!Number.isFinite(x)||!Number.isFinite(y))return false;if(!grid)buildGrid();for(const p of shapes.get(key(Math.floor(x/CELL),Math.floor(y/CELL)))??[])if(inside(p,x,y))return true;return false;}
