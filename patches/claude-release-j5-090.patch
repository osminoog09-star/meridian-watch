+import test from 'node:test';import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import {MODELS} from '../dist/models.js';
+// J5 (Claude, 16.10.2026): the garage preview drew every service vehicle as a police sedan.
+test('the garage preview uses the vehicle\'s own model',()=>{
+ const app=fs.readFileSync(new URL('../dist/app.js',import.meta.url),'utf8');
+ const src=app.match(/function garageModel\(type\)\{[^\n]*\}/)[0];const garageModel=new Function('MODELS',src+';return garageModel;')(MODELS);
+ for(const t of ['engine','ladder','tanker','ambulance','resus'])assert.equal(garageModel(t),MODELS[t],t);
+ assert.equal(garageModel('rapid'),MODELS.suv);assert.equal(garageModel('suv'),MODELS.suv);assert.equal(garageModel('sedan'),MODELS.sedan);
+ assert.match(app,/drawModel\(ctx,garageModel\(v\.type\),fitModel\(garageModel\(v\.type\),/);
+});
