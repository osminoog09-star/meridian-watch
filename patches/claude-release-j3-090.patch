--- a/tests/uniforms.test.mjs	1970-01-01 03:00:00.000000000 +0300
+++ b/tests/uniforms.test.mjs	2026-10-15 23:27:49.527633803 +0300
@@ -0,0 +1,13 @@
+import test from 'node:test';import assert from 'node:assert/strict';
+import {modelPalette,SERVICE_UNIFORMS} from '../dist/models.js';
+import fs from 'node:fs';
+// J3 (Claude, 15.10.2026): rescuers and ambulance crews no longer wear the police uniform.
+test('crews wear their service uniform; police and residents are unchanged',()=>{
+ const police=modelPalette({officer:true}),rescue=modelPalette({officer:true,service:'rescue'}),ems=modelPalette({officer:true,service:'ems'});
+ assert.equal(police.uniform,'#3d6d8a');assert.equal(modelPalette({officer:true,service:'police'}).uniform,police.uniform);
+ for(const p of [rescue,ems])for(const k of ['uniform','trousers','vest'])assert.notEqual(p[k],police[k],k);
+ assert.notEqual(rescue.uniform,ems.uniform);assert.equal(rescue.paint,police.paint,'only the clothes change');
+ assert.equal(modelPalette({color:'#123456',service:'ems'}).uniform,'#123456','residents keep their colour');
+ assert.ok(Object.isFrozen(SERVICE_UNIFORMS.rescue));
+ assert.match(fs.readFileSync(new URL('../dist/render.js',import.meta.url),'utf8'),/activity\.pose,u\.agency\?\?s\.agency\)/,'crews are drawn with their unit\'s service');
+});
