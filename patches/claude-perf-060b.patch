 function audioPanel(){const prefs=audio.preferences();modal(`<span class="eyebrow">НАСТРОЙКИ / MERCURY RESPONSE</span><h2>Настройки игры</h2><h3>Звук</h3><label><input id="audioEnabled" type="checkbox" ${prefs.enabled?'checked':''}> Включить звук</label>${[['master','Общая громкость'],['radio','Сигналы радио'],['siren','Сирена экипажа'],['engine','Двигатель экипажа'],['environment','Городская среда']].map(([key,label])=>`<label for="audio-${key}">${label}<input id="audio-${key}" type="range" min="0" max="100" step="1" value="${Math.round(prefs[key]*100)}"></label>`).join('')}<button id="testAudio">Включить и проверить звук</button><p><a href="prototype3d.html?v=0.4.21">Открыть отдельный прототип 3D-квартала →</a></p><p>3D-модели: <a href="police-prototype.html">Полицейские</a> · <a href="cars-prototype.html">Машины</a> · <a href="people-prototype.html">Жители</a></p><button id="openDiagnostics">FPS и диагностика</button><h3>Время города</h3><label>Темп города<select id="settingsWorldRate"><option value="1">Реальное время: 1 секунда = 1 секунда города</option><option value="45">Быстрая смена: 1 секунда = 45 секунд города</option></select></label><p>Кнопки ×1/×2/×4 ускоряют вместе часы, машины, людей и работу. В реальном времени смена длится 6 часов, первый обычный вызов появляется примерно через 9 минут. Быстрая смена сохраняет прежний темп.</p><h3>Графика</h3><label><input id="settingsAdaptive" type="checkbox"> Автоматически снижать разрешение при просадках</label><p>Модели и город сохраняются. При перегрузке карта становится мягче; после устойчивого восстановления разрешение повышается. Это не меняет время и скорость мира.</p><label>Частота карты<select id="settingsFrameRate"><option value="30">30 кадров/с — меньше нагрузки</option><option value="60">60 кадров/с — плавнее, больше нагрузки</option></select></label><p>«Объёмные модели — экономия» сохраняет модели, но уменьшает разрешение карты. На плотном экране изображение будет мягче; правила игры не меняются.</p><label for="settingsGraphics">Машины и сотрудники<select id="settingsGraphics"><option value="models">Объёмные модели</option><option value="eco">Объёмные модели — экономия</option><option value="simple">Простые обозначения</option></select></label><label><input id="settingsLighting" type="checkbox"> Ночное освещение и световые эффекты</label><button id="applyAudio" class="primary">Сохранить настройки</button><p>Ветер, вода рядом с рекой и фонтаном, дальний транспорт движущихся жителей. Сигнал нового вызова и завершения; двигатель движущегося выбранного экипажа, сирена при срочном движении. В паузе, меню и скрытой вкладке звук прекращается. Это первые синтезированные звуки, без голосовых реплик. Вся важная информация остаётся на экране.</p><p class="fine-print">Если браузер не поддерживает звук, игра продолжит работу. После возврата в приложение может потребоваться нажать продолжение смены.</p>`);$('openDiagnostics').onclick=diagnosticPanel;$('testAudio').onclick=async()=>{const next={enabled:true};for(const key of ['master','radio','siren','engine','environment'])next[key]=+$('audio-'+key).value/100;audio.configure(next);$('audioEnabled').checked=true;try{localStorage.setItem(AUDIO_KEY,JSON.stringify(audio.preferences()));}catch{}toast(await audio.testSound()?'Проверочный сигнал отправлен. Громкость задаётся ползунками.':'Браузер не запустил звук.');};$('audioEnabled').checked=prefs.enabled;$('settingsGraphics').value=graphicsQuality;$('settingsFrameRate').value=String(frameRate);$('settingsWorldRate').value=String(worldRate);$('settingsAdaptive').checked=adaptiveResolution;$('settingsLighting').checked=lightingEnabled;$('applyAudio').onclick=async()=>{adaptiveResolution=$('settingsAdaptive').checked;renderer.resolution(resolutionGovernor.reset());try{localStorage.setItem('mercury-adaptive-resolution',adaptiveResolution?'on':'off');}catch{}worldRate=$('settingsWorldRate').value==='45'?45:1;simulationClock.rate(worldRate);try{localStorage.setItem('mercury-world-rate',String(worldRate));}catch{}diagnostics.event('world-rate',String(worldRate));frameRate=$('settingsFrameRate').value==='60'?60:30;framePacer.rate(frameRate);try{localStorage.setItem('mercury-frame-rate',String(frameRate));}catch{}graphicsQuality=$('settingsGraphics').value;lightingEnabled=$('settingsLighting').checked;renderer.quality(graphicsQuality);renderer.lighting(lightingEnabled);diagnostics.event('graphics',graphicsQuality+' lighting='+lightingEnabled);diagnostics.resetFrames();try{localStorage.setItem('meridian-watch-graphics-v1',graphicsQuality);localStorage.setItem('meridian-watch-lighting-v1',lightingEnabled?'on':'off');}catch{}const next={enabled:$('audioEnabled').checked};for(const key of ['master','radio','siren','engine','environment'])next[key]=+$('audio-'+key).value/100;audio.configure(next);let ok=!next.enabled||await audio.unlock();try{localStorage.setItem(AUDIO_KEY,JSON.stringify(audio.preferences()));}catch{}close();toast(ok?(next.enabled?'Звук включён':'Звук выключен'):'Браузер не запустил звук. Игра продолжит работу.');};}
