+// Release H «Спасатели» (Claude, 12.10.2026). A rescue campaign: the player serves in (or runs) the
+// rescue station of Meridian instead of the police department. Same city, same engine; the calls,
+// vehicles, crews, ranks and the work on scene are the rescuers'.
+// Facts behind the numbers (Päästeamet; ERR 2019–2026; readiness rules of the Rescue Board):
+//  · turnout: 60 s for high-risk calls with lights and siren, 3 min for low-risk calls;
+//  · the first vehicle should be on scene within about 5 minutes in a city (15 min anywhere in Estonia);
+//  · a city station keeps 8–11 rescuers on duty; a main vehicle (põhiauto) goes with 3–4, a ladder needs
+//    four, the tanker (paakauto) brings extra water; ranks: rescuer, senior rescuer, team leader
+//    (meeskonnavanem / rühmapealik), station commander (komandopealik);
+//  · ≈2 300 fires a year, ≈400 in homes; smoking causes half of the deadly fires; homes without a working
+//    smoke detector are where people die; rescuers visit homes and check detectors (prevention).
+// Pure rules: sim.js and scenes.js call these; nothing here touches the police campaign.
+import {MAP_METRES} from './world-scale.js';
+import {WORLD_SECONDS_PER_TICK_SECOND} from './transport.js';
+export const RESCUE_SERVICE='rescue';
+export const isRescue=s=>s?.agency===RESCUE_SERVICE;/* `s.service` is the career service record — the agency is a separate field */
+const worldMin=dt=>dt*WORLD_SECONDS_PER_TICK_SECOND/60;
