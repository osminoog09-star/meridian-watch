+import {weatherFor,WEATHER} from '../dist/calls.js';
+// Seasons, daylight and road weather on the roster calendar.
+
+test('the roster calendar has real dates and seasons',()=>{
+ assert.equal(shiftDate(0).label,'12.10');assert.equal(seasonOf(shiftDate(0).month),'autumn');
+ let k=0;while(seasonOf(shiftDate(k).month)!=='winter')k++;assert.equal(shiftDate(k).month,11,'December comes first');
+ const winter=new Set(Array.from({length:40},(_,n)=>weatherFor(7182,n,'winter').kind));assert.ok(winter.has('snow')&&winter.has('ice'));
+ const summer=new Set(Array.from({length:40},(_,n)=>weatherFor(7182,n,'summer').kind));assert.ok(summer.has('heat')&&!summer.has('snow'));
+ for(const kind of [...winter,...summer])assert.ok(WEATHER[kind],kind);
+ assert.ok(weatherFor(7182,5,'winter').temp<=2);
+ assert.deepEqual(weatherFor(7182,3),weatherFor(7182,3,null),'legacy weather unchanged');
+ const s=createGame('career',7182,{schedule:'ppa'});assert.equal(shiftDateOf(s).label,'12.10');assert.deepEqual(sunOf(s),SUN[9]);assert.equal(shiftDateOf(createGame()),null);
+});
+
