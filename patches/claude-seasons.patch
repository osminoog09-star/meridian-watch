+ const dec=SUN[11],jun=SUN[5];assert.ok(cityLighting(8*60,dec).darkness>0,'dark at 08:00 in December');assert.equal(cityLighting(8*60,jun).darkness,0);
+ assert.ok(cityLighting(21*60,jun).darkness===0||cityLighting(21*60,jun).darkness<.2,'light June evening');assert.equal(cityLighting(18*60,dec).darkness,.55);
+});
+
