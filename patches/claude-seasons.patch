+// Seasons and daylight for roster campaigns (Claude, 11.10.2026). The PPA calendar (schedule.js)
+// gives every shift a real date; a new campaign starts on 12 October. Pärnu climate and daylight:
+// January ≈ −4 °C and 7 h of daylight, July ≈ +17 °C and 18 h. Snow and black ice slow every car
+// and multiply crashes; summer heat brings yards, bars and the beach to life.
+import {shiftStartMinute} from './schedule.js';
+export const CAMPAIGN_EPOCH=Date.UTC(2026,9,12);// day 2 of the roster clock = 12.10.2026
+export function dateOf(minute){const day=Math.floor(minute/1440)-2,d=new Date(CAMPAIGN_EPOCH+day*86400000);return {month:d.getUTCMonth(),dayOfMonth:d.getUTCDate(),year:d.getUTCFullYear(),label:`${String(d.getUTCDate()).padStart(2,'0')}.${String(d.getUTCMonth()+1).padStart(2,'0')}`};}
+export const shiftDate=index=>dateOf(shiftStartMinute(index));
+export const SEASONS=Object.freeze({winter:'Зима',spring:'Весна',summer:'Лето',autumn:'Осень'});
+export const seasonOf=month=>month<=1||month===11?'winter':month<=4?'spring':month<=7?'summer':'autumn';
+// Local sunrise/sunset (minutes) per month, Pärnu, rounded; DST included.
+export const SUN=Object.freeze([[540,960],[480,1035],[420,1110],[390,1230],[315,1290],[255,1365],[270,1350],[345,1275],[420,1185],[480,1095],[495,975],[550,945]]);
+export const SEASON_WEATHER=Object.freeze({
+ winter:{order:['snow','clear','ice','snow','fog','clear','snow','wind'],temps:{snow:[-9,-1],clear:[-14,-3],ice:[-3,1],fog:[-4,2],wind:[-8,0]}},
+ spring:{order:['clear','rain','clear','wind','rain','clear','fog','clear'],temps:{clear:[6,16],rain:[3,10],wind:[4,11],fog:[1,7]}},
+ summer:{order:['clear','heat','clear','rain','clear','heat','wind','clear'],temps:{clear:[17,24],heat:[25,31],rain:[13,19],wind:[15,20]}},
+ autumn:{order:['rain','clear','fog','rain','wind','clear','rain','fog'],temps:{rain:[4,11],clear:[5,13],fog:[2,8],wind:[3,10]}}
+});
+// Speed of all traffic in the weather (black ice is the worst).
+export const WEATHER_SPEED=Object.freeze({snow:.8,ice:.7,fog:.9});
+export const weatherSpeed=kind=>WEATHER_SPEED[kind]??1;
