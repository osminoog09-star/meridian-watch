+// J4 (Claude, 15.10.2026): a rescue or ambulance chief has no police custody orders; no «участок» in their texts.
+test('custody orders are police only; the priority district works for every chief',()=>{
+ const p=createGame('chief',7182,{schedule:'ppa'});assert.ok(policyApplies(p));assert.ok(setPolicy(p,'strict'));assert.equal(policyOf(p).label,'Нулевая терпимость');assert.ok(policyCost(p)>=120);
+ for(const service of ['rescue','ems']){const s=createGame('chief',7182,{schedule:'ppa',service});
+  assert.equal(policyApplies(s),false);assert.equal(setPolicy(s,'strict'),false);assert.equal(policyOf(s).label,'Обычный порядок');
+  s.policy='strict';assert.equal(policyOf(s).label,'Обычный порядок','an old saved order has no effect');assert.equal(policyCost(s),0);assert.ok(setPriorityDistrict(s,'centre'));assert.equal(policyCost(s),60,'the priority district still costs and works');
+  deserialize(serialize(s));}
+ const app=fs.readFileSync(new URL('../dist/app.js',import.meta.url),'utf8');assert.match(app,/state\.agency\?'Приоритет района':'Правила отделения'/);
