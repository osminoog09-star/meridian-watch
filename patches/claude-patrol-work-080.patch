+function quiet(){const s=createGame('career',4411,{schedule:'ppa'});s.nextIncident=9000;for(const u of s.units)u.tasksToday=99;for(let k=0;k<200;k++)tick(s,.1);return s;}
+
+test('the player orders a sobriety checkpoint: the crew drives to a road, works, reports and prevents',()=>{
+ assert.equal(startPatrolTask(createGame(),1,'breath-check').ok,false,'old campaigns have no patrol work');
+ const s=quiet(),u=s.units[0];assert.equal(startPatrolTask(s,1,'nope').ok,false);
+ const trust=s.trust,xp=s.xp;assert.equal(startPatrolTask(s,1,'breath-check').ok,true);assert.equal(u.status,'proactive');assert.equal(u.task.phase,'moving');
+ assert.match(unitReason(s,u),/Едем на место/);assert.equal(startPatrolTask(s,1,'speed-check').ok,false,'busy');
+ assert.doesNotThrow(()=>deserialize(serialize(s)));
+ for(let k=0;k<6000&&u.status==='proactive';k++)tick(s,.1);
+ assert.equal(u.status,'patrol');assert.equal(s.tasksDone[0].task,'breath-check');assert.equal(s.tasksDone[0].done,true);assert.match(s.tasksDone[0].text,/проверено \d+ водителей/);
+ assert.ok(s.trust>trust);assert.ok(s.xp>xp);assert.ok(preventionMods(s)['drunk-driver']<1);
+ const w={...shiftWeather(s),prevention:preventionMods(s)};assert.ok(share('drunk-driver',w,23*60)<share('drunk-driver',shiftWeather(s),23*60));
+ assert.doesNotThrow(()=>deserialize(serialize(s)));
+ s.ended=true;const n=nextShift(s);assert.ok(n.units.every(x=>x.task===undefined&&x.status!=='proactive'));assert.equal(n.prevention,undefined);
