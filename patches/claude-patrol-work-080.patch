+ const autumn={kind:'rain',season:'autumn'},winter={kind:'snow',season:'winter'},summer={kind:'clear',season:'summer'};
+ assert.ok(share('phone-scam',autumn)>0);assert.ok(share('restraining-order',autumn,20*60)>0);
+ assert.equal(share('thin-ice',autumn),0);assert.ok(share('thin-ice',winter)>0);assert.equal(share('beach-party',winter,23*60),0);assert.ok(share('beach-party',summer,23*60)>0);
